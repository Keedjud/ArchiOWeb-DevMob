{
  "name": "bomb-api",
  "version": "1.0.0",
  "description": "API REST du projet BOMB (Express + MongoDB). Cours ArchiOWeb.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env bin/start.js",
    "start": "node bin/start.js",
    "test": "node --env-file=.env.test --test --test-concurrency=1",
    "test:coverage": "c8 --reporter=text --reporter=html --exclude=\"tests/**\" npm test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.3.0",
    "mongoose": "^9.12.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "c8": "^12.0.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2"
  }
}
