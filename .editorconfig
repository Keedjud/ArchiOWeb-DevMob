# Réglages d'éditeur partagés par toute l'équipe (https://editorconfig.org)
# Valeurs de départ, à ajuster en groupe.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# En Markdown, deux espaces en fin de ligne = retour à la ligne volontaire
trim_trailing_whitespace = false
